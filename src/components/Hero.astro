---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="min-h-screen flex items-center justify-center pt-28 pb-10 relative overflow-hidden">
    <div class="blob bg-purple-600/30 w-[500px] h-[500px] top-0 -left-40"></div>
  <div class="blob bg-orange-500/20 w-[400px] h-[400px] bottom-10 -right-20" style="animation-delay: -5s;"></div>

  <div class="max-w-7xl mx-auto px-6 z-10 relative w-full">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      
            <div class="text-center lg:text-left">
        <div class="inline-block mb-6 px-4 py-1.5 rounded-full border border-white/10 glass text-sm text-slate-300 font-medium reveal">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 mr-2 animate-pulse shadow-[0_0_10px_rgba(52,211,153,0.8)]"></span>
          {t('hero.badge')}
        </div>
        <h1 class="text-5xl md:text-7xl font-bold text-white mb-6 tracking-tight leading-[1.1] reveal reveal-delay-100">
          {t('hero.hello')} <span class="text-gradient block mt-2">Marco Gajardo</span>
        </h1>
        <h2 class="text-2xl md:text-3xl font-semibold text-purple-400 mb-8 reveal reveal-delay-200">
          {t('hero.role')}
        </h2>
        <p class="text-lg md:text-xl text-slate-400 mb-10 max-w-2xl mx-auto lg:mx-0 leading-relaxed reveal reveal-delay-300">
          {t('hero.desc')}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start items-center reveal reveal-delay-300">
          <a href="#projects" class="px-8 py-3.5 rounded-full bg-gradient-to-r from-purple-600 to-orange-500 text-white font-semibold shadow-lg shadow-purple-500/25 hover:shadow-purple-500/40 hover:scale-105 transition-all w-full sm:w-auto">
            {t('hero.btnProjects')}
          </a>
          <a href="#contact" class="px-8 py-3.5 rounded-full glass hover:bg-white/5 text-white font-semibold transition-all hover:scale-105 border border-white/10 w-full sm:w-auto">
            {t('hero.btnContact')}
          </a>
        </div>

        <div class="flex gap-6 justify-center lg:justify-start items-center mt-10 reveal reveal-delay-400">
          <a href="https://github.com/Bonnish" target="_blank" class="text-slate-400 hover:text-white transition-colors hover:scale-110">
            <span class="sr-only">GitHub</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
          </a>
          <a href="https://www.linkedin.com/in/marco-gajardo-jimenez-41bb80408/" target="_blank" class="text-slate-400 hover:text-[#0a66c2] transition-colors hover:scale-110">
            <span class="sr-only">LinkedIn</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
          <a href="/CV.pdf" target="_blank" class="flex items-center gap-2 text-sm font-medium text-slate-400 hover:text-orange-400 transition-colors border border-white/10 rounded-full px-4 py-1.5 hover:bg-white/5 hover:border-orange-400/50">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            {t('hero.cv')}
          </a>
        </div>
      </div>

            <div class="hidden lg:block reveal reveal-delay-200 perspective-1000">
        <div class="glass-card rounded-xl overflow-hidden border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] transform rotate-y-[-5deg] rotate-x-[5deg] hover:rotate-0 transition-transform duration-700 relative">
                    <div class="bg-black/40 px-4 py-3 flex items-center gap-2 border-b border-white/5">
            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
            <span class="ml-4 text-xs font-mono text-slate-500">developer.py</span>
          </div>
                    <div class="p-6 font-mono text-sm md:text-base leading-relaxed overflow-x-auto min-h-[300px]">
            <div id="code-typer" class="text-slate-300 whitespace-pre"></div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<script>
  const codeString = `class SoftwareEngineer:
    def __init__(self):
        self.name = "Marco Gajardo"
        self.role = "Full Stack Developer"
        self.passions = ["Coding", "Game Development", "Gaming"]
        
    def create_value(self):
        return "Transform ideas into fast, scalable solutions."

me = SoftwareEngineer()
me.create_value()`;

  const typeCode = () => {
    const el = document.getElementById('code-typer');
    if (!el) return;
    const highlight = (text) => {
      let html = text
        .replace(/class /g, '%%CLASS%%')
        .replace(/def /g, '%%DEF%%')
        .replace(/return /g, '%%RETURN%%')
        .replace(/self\./g, '%%SELFDOT%%')
        .replace(/self\)/g, '%%SELFPAREN%%')
        .replace(/__init__/g, '%%INIT%%')
        .replace(/create_value/g, '%%CREATE%%')
        .replace(/SoftwareEngineer/g, '%%SE%%');
      html = html.replace(/(".*?")/g, "<span class='text-green-400'>$1</span>");
      html = html.replace(/(\[.*?\])/g, "<span class='text-yellow-300'>$1</span>");
      html = html
        .replace(/%%CLASS%%/g, "<span class='text-purple-400'>class </span>")
        .replace(/%%DEF%%/g, "<span class='text-purple-400'>def </span>")
        .replace(/%%RETURN%%/g, "<span class='text-purple-400'>return </span>")
        .replace(/%%SELFDOT%%/g, "<span class='text-orange-400'>self</span>.")
        .replace(/%%SELFPAREN%%/g, "<span class='text-orange-400'>self</span>)")
        .replace(/%%INIT%%/g, "<span class='text-blue-400'>__init__</span>")
        .replace(/%%CREATE%%/g, "<span class='text-blue-400'>create_value</span>")
        .replace(/%%SE%%/g, "<span class='text-emerald-400'>SoftwareEngineer</span>");
        
      return html;
    };

    let i = 0;
    el.innerHTML = '';
    
    const interval = setInterval(() => {
      if (i < codeString.length) {
        let currentText = codeString.substring(0, i + 1);
        el.innerHTML = highlight(currentText) + '<span class="animate-pulse inline-block w-2 h-5 bg-white/70 ml-1 align-middle"></span>';
        i++;
      } else {
        clearInterval(interval);
      }
    }, 45);
  };

  const observer = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) {
      setTimeout(typeCode, 500);
      observer.disconnect();
    }
  });
  
  const section = document.getElementById('about');
  if (section) observer.observe(section);
</script>
