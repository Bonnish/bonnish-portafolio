---
const technologies = [
  { name: "Python", icon: `<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/>` },
  { name: "Django", icon: `<rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><path d="M7 8v8"/><path d="M11 8v8"/><path d="M15 8v8"/>` },
  { name: "React", icon: `<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>` },
  { name: "PostgreSQL", icon: `<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/>` },
  { name: "MySQL", icon: `<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/><line x1="12" y1="5" x2="12" y2="19"/>` },
  { name: "MongoDB", icon: `<path d="M12 2c0 0-4 4-4 10s4 10 4 10 4-4 4-10-4-10-4-10z"/><path d="M12 22v-4"/>` },
  { name: "HTML5", icon: `<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>` },
  { name: "CSS3", icon: `<path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/>` },
  { name: "JavaScript", icon: `<rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><path d="M9 8v8"/><path d="M15 8v8"/>` },
  { name: "C#", icon: `<path d="M6 12h12"/><path d="M6 8h12"/><path d="M10 4v16"/><path d="M14 4v16"/>` },
  { name: "Unity", icon: `<path d="M12 2l8 4.6v9.2L12 20.4l-8-4.6V6.6z"/><path d="M12 22v-9.6"/><path d="M12 12.4L4 7.8"/><path d="M12 12.4l8-4.6"/>` },
  { name: "Godot", icon: `<circle cx="12" cy="12" r="10"/><circle cx="9" cy="10" r="1.5"/><circle cx="15" cy="10" r="1.5"/><path d="M8 15h8"/>` },
  { name: "AWS", icon: `<path d="M17.5 19A9 9 0 1 0 4 10.5 4 4 0 0 0 8 18h9.5A3.5 3.5 0 0 0 17.5 19Z"/>` },
  { name: "Lua", icon: `<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>` },
  { name: "Astro", icon: `<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>` },
  { name: "Tailwind CSS", icon: `<path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/>` },
  { name: "Git", icon: `<line x1="6" x2="6" y1="3" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>` }
];

// Duplicate the array to create a seamless infinite scroll
const doubleTech = [...technologies, ...technologies];
---

<div class="w-full overflow-hidden bg-white/5 border-y border-white/10 py-6 flex">
  <div class="flex scrolling-marquee whitespace-nowrap min-w-max">
    {doubleTech.map((tech) => (
      <div class="flex items-center gap-3 px-10 text-slate-400 hover:text-white transition-colors duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={tech.icon}></svg>
        <span class="text-2xl font-medium tracking-tight">{tech.name}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .scrolling-marquee {
    animation: scroll 30s linear infinite;
  }
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
